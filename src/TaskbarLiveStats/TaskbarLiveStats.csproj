<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>TaskbarLiveStats</RootNamespace>
    <AssemblyName>TaskbarLiveStats</AssemblyName>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.19" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

  <!-- Runtime branding for tray / settings / about (single-file safe). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="TaskbarLiveStats.Assets.app.ico" />
    <EmbeddedResource Include="Assets\app.png" LogicalName="TaskbarLiveStats.Assets.app.png" />
    <EmbeddedResource Include="Assets\app-on-dark.png" LogicalName="TaskbarLiveStats.Assets.app-on-dark.png" />
  </ItemGroup>

</Project>
